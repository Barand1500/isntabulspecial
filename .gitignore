# Only application and deployment files belong in this repository.
/*
!/.gitignore
!/.dockerignore
!/.gitattributes
!/README.md
!/package.json
!/package-lock.json
!/index.html
!/tsconfig.json
!/vite.config.ts
!/Dockerfile
!/nginx.conf
!/src/
!/public/

# Local configuration and credentials, including nested copies.
.env
.env.*
.npmrc
*.pem
*.key
*.p12
*.pfx
*.log
**/node_modules/
**/.DS_Store
**/Thumbs.db
*.tsbuildinfo

# Unused full-resolution source images; the site uses WebP versions.
/public/images/hero-food.png
/public/images/service-food.png
/public/images/ingredients.png

# Admin API sources; database and environment secrets stay local.
!/server/
!/.env.example
*.sqlite
*.sqlite-*
*.db
*.db-*

# Production deployment scripts and CloudPanel instructions.
!/scripts/
!/deploy/
